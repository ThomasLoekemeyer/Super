# Copiá este archivo a .env.local y completá con los datos de TU proyecto
# de Supabase (Dashboard → Project Settings → API / API Keys).
# La publishable/anon key es pública por diseño (viaja en el bundle del
# cliente); la seguridad real está en las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
